# Machine Learning / YOLO specific exclusions
# Datasets (YOLO usually downloads or creates heavy image/label folders)
# Since you have a 'data' folder, we ignore dataset files but keep configuration if needed.
# If you want to keep data structure but ignore images/labels, you can be specific.
# Here we ignore all files in data/ except possibly template config files if any.
# For now, let's ignore large data downloads.
data/

# Model Weights (YOLO model weights are usually very large, e.g., best.pt, last.pt, yolov8n.pt)
# *.pt  # Cho phép push model weights
*.pth
*.onnx
*.engine
*.tflite
*.pb
*.weights

# Pretrained weights at root/src level (downloaded, not trained)
/yolov8s.pt
/yolo26n.pt
src/yolov8s.pt
src/yolo26n.pt

# Periodic epoch checkpoints (too large ~64MB each, keep only best.pt & last.pt)
**/weights/epoch*.pt

# YOLO training runs / logs / output results
# runs/  # Cho phép push kết quả training
runs/detect/val/
wandb/
mlflow/
